# Copy to .env (gitignored) and fill in. Never commit .env.
# Dedicated IAM user for this project: Bedrock invoke + one OpenSearch Serverless collection.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# New collection for this project (same region as Bedrock).
OPENSEARCH_COLLECTION=company-brain

# Langfuse Cloud: the instructor must be able to reach the project as a Member.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Where the NovaOps dataset copy lives (not committed).
DATASET_ROOT=data/novaops

# Shared by the app and the MCP server: signs consent so a raw MCP client cannot forge it. Any long random string; never commit the real one.
CONSENT_SECRET=
